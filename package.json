{
  "name": "robusst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "browserslist": [
    "chrome >= 87",
    "firefox >= 78",
    "safari >= 14",
    "edge >= 88"
  ],
  "scripts": {
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "ready": "pnpm format:write && pnpm lint && pnpm typecheck && pnpm build",
    "check": "next lint && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "next dev --port 3000",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "lint": "eslint --fix",
    "preview": "next build && next start",
    "sanity:studio": "sanity dev",
    "sanity:schema": "sanity schema extract --enforce-required-fields --path=sanity.schema.json --force",
    "sanity:typegen": "pnpm sanity:schema && sanity typegen generate",
    "sanity:validate": "sanity documents validate --yes --level error",
    "sanity:assets:dry": "node scripts/migrate-sanity-assets.mjs",
    "sanity:assets:upload": "node scripts/migrate-sanity-assets.mjs --execute",
    "sanity:assets:validate": "node scripts/validate-sanity-assets.mjs",
    "sanity:global:dry": "node scripts/migrate-sanity-global-content.mjs",
    "sanity:global:migrate": "node scripts/migrate-sanity-global-content.mjs --execute",
