    "sanity:network-monetization:validate": "node scripts/validate-sanity-network-monetization.mjs",
    "sanity:sts-dms:dry": "node scripts/migrate-sanity-sts-dms.mjs",
    "sanity:sts-dms:migrate": "node scripts/migrate-sanity-sts-dms.mjs --execute",
    "sanity:sts-dms:validate": "node scripts/validate-sanity-sts-dms.mjs",
    "sanity:stories:dry": "node scripts/migrate-sanity-stories.mjs",
    "sanity:stories:migrate": "node scripts/migrate-sanity-stories.mjs --execute",
    "sanity:stories:validate": "node scripts/validate-sanity-stories.mjs",
    "sanity:blogs:dry": "node scripts/migrate-sanity-blogs.mjs",
    "sanity:blogs:migrate": "node scripts/migrate-sanity-blogs.mjs --execute",
    "sanity:blogs:validate": "node scripts/validate-sanity-blogs.mjs",
    "sanity:discovery:validate": "node scripts/validate-sanity-discovery.mjs",
    "sanity:migrate:dry": "sanity migration run",
    "sanity:migrate": "sanity migration run --no-dry-run",
    "start": "next start",
    "typecheck": "tsc --noEmit"
